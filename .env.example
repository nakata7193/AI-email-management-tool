# Gmail API Configuration
GMAIL_CREDENTIALS_FILE=credentials.json
GMAIL_TOKEN_FILE=token.json

# IMAP Configuration (for non-Gmail accounts)
IMAP_SERVER=imap.gmail.com
IMAP_PORT=993
IMAP_EMAIL=your.email@gmail.com
IMAP_PASSWORD=your_app_specific_password

# Claude API
ANTHROPIC_API_KEY=sk-ant-your-api-key-here

# Database
CACHE_DB_PATH=email_cache.db

# Application Settings
MAX_FETCH_EMAILS=100
CACHE_MAX_AGE_DAYS=30

# ===== Multiple Account Configuration (Profiles) =====
# To manage multiple email accounts, create profiles and prefix their variables
# Example: Work profile

# WORK_GMAIL_CREDENTIALS_FILE=credentials_work.json
# WORK_GMAIL_TOKEN_FILE=token_work.json

# Example: Personal Gmail profile
# PERSONAL_GMAIL_CREDENTIALS_FILE=credentials_personal.json
# PERSONAL_GMAIL_TOKEN_FILE=token_personal.json

# Example: IMAP work account
# WORKMAIL_IMAP_SERVER=outlook.office365.com
# WORKMAIL_IMAP_PORT=993
# WORKMAIL_IMAP_EMAIL=you@company.com
# WORKMAIL_IMAP_PASSWORD=your_app_password

# Usage:
# 1. Create profile: python main.py profile create work --description "Work Gmail" --provider gmail
# 2. Set as active: python main.py profile use work
# 3. Use with flag: python main.py --profile work inbox
